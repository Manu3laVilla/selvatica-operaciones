# Ruta al archivo JSON de credenciales del Service Account de Google
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# ID de la hoja de Google Sheets (está en la URL: /d/ESTE_ID/edit)
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Supabase (PostgreSQL). Project → Connect → Session pooler (recomendado en Windows / IPv4).
# DATA_BACKEND=supabase
# DATABASE_POOLER_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-XXXX.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_REF.supabase.co:5432/postgres

# Inicio de sesión (opcional). Si AUTH_PASSWORD está vacío, el login no se exige.
# AUTH_ENABLED=true
# AUTH_USERNAME=selvatica
# AUTH_PASSWORD=tu_contraseña_segura
# Duración de sesión (por defecto 1 hora; se renueva con cada interacción en la app)
# AUTH_SESSION_HOURS=1
# AUTH_SECRET=clave_larga_para_firmar_cookies (opcional; si no, usa AUTH_PASSWORD)
